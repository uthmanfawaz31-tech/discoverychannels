# Obtain API_ID and API_HASH from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Obtain BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# (Optional) Phone number with country code (e.g. +1234567890)
# If provided, the script can run with user-level privileges for channels/groups
PHONE_NUMBER=
